{
  "items": [
    {
      "label": "Launch Code",
      "run": "code .",
      "group": "open"
    },
    {
      "label": "Launch Finder",
      "run": "open .",
      "group": "open"
    },
    {
      "label": "Launch Xcode project",
      "run": "open {{file:*.xcodeproj *.xcworkspace}}",
      "group": "open",
      "desc": "xcode ios swift"
    },
    {
      "label": "Commit everything",
      "run": "git add -A && git commit -m {{prompt:Message=Automated commit}}",
      "group": "git",
      "if": "git rev-parse --is-inside-work-tree"
    },
    {
      "label": "Discard all changes",
      "run": "git reset --hard && git clean -fd",
      "group": "git",
      "if": "git rev-parse --is-inside-work-tree",
      "confirm": true
    },
    {
      "label": "Deploy to staging",
      "run": "./scripts/deploy.sh staging",
      "group": "ops",
      "edit": true,
      "desc": "release ship"
    }
  ]
}
